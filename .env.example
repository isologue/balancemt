ADDR=:8080
DATA_DIR=/app/data
ENCRYPTION_KEY=replace-with-a-long-random-secret
MONITOR_INTERVAL_SECONDS=10
# 邮件告警（留空表示关闭）
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# 短信告警：twilio 或 webhook，留空表示关闭
SMS_PROVIDER=
SMS_TO=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
